# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Tab é sintaxe em Makefile, não estilo.
[Makefile]
indent_style = tab

# PowerShell e AutoHotkey rodam no Windows, onde a convenção é CRLF; forçar LF
# quebra o AHK, que é sensível a isso em algumas diretivas.
[*.{ps1,psm1,ahk}]
end_of_line = crlf
indent_size = 4

[*.md]
trim_trailing_whitespace = false
