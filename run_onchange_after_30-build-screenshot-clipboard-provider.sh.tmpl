#!/usr/bin/env bash
set -euo pipefail
{{- $profile := (index . "profile") | default (ternary "hyprland" "generic" (ne (lookPath "Hyprland") "")) }}
{{ if and (eq .chezmoi.os "linux") (eq $profile "kde") }}
# provider.c: {{ include "dot_local/share/screenshot-clipboard/provider.c" | sha256sum }}
# wayland-protocols: {{ output "sh" "-c" "pacman -Q wayland-protocols 2>/dev/null || printf missing" | trim }}

source_dir=${XDG_DATA_HOME:-"$HOME/.local/share"}/screenshot-clipboard
protocol_file=/usr/share/wayland-protocols/staging/ext-data-control/ext-data-control-v1.xml
target_file=$HOME/.local/bin/screenshot-clipboard-provider
build_dir=$(mktemp -d /tmp/screenshot-clipboard-build.XXXXXX)
trap 'rm -rf "$build_dir"' EXIT

[[ -f "$protocol_file" ]] || {
    echo "screenshot-clipboard: instale wayland-protocols e reaplique o chezmoi" >&2
    exit 0
}

wayland-scanner client-header \
    "$protocol_file" \
    "$build_dir/ext-data-control-v1-client-protocol.h"
wayland-scanner private-code \
    "$protocol_file" \
    "$build_dir/ext-data-control-v1-protocol.c"

# pkg-config intentionally expands into separate compiler and linker arguments.
# shellcheck disable=SC2046
cc -std=c11 -O2 -Wall -Wextra -Wpedantic \
    -I"$build_dir" \
    "$source_dir/provider.c" \
    "$build_dir/ext-data-control-v1-protocol.c" \
    $(pkg-config --cflags --libs wayland-client) \
    -o "$build_dir/screenshot-clipboard-provider"

install -Dm0755 "$build_dir/screenshot-clipboard-provider" "$target_file"
echo "screenshot-clipboard: provedor multimídia compilado"
{{ end }}
