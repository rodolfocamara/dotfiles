#!/usr/bin/env bash
set -euo pipefail
{{ if eq .chezmoi.os "linux" }}
{{- $launchers := printf "%s/.local/share/applications/brave-*.desktop" .chezmoi.homeDir }}
{{- $strays := printf "%s/Desktop/brave-*.desktop" .chezmoi.homeDir }}
# lançadores: {{ output "sh" "-c" (printf "{ grep -h -E '^(Exec|NoDisplay)=' %s; ls -d %s; } 2>/dev/null | sha256sum | cut -d' ' -f1" $launchers $strays) | trim }}

# /usr/bin/brave é um wrapper: ele lê ~/.config/brave-flags.conf, monta a lista
# de flags e faz exec no binário real. /opt/brave-bin/brave é o binário cru e
# não lê arquivo nenhum. Quem chama o caminho de /opt perde as flags — hoje
# --password-store e --enable-features=FedCm.
#
# O Brave gera os .desktop dos PWAs sozinho, apontando pro próprio executável,
# que é sempre o de /opt. Então isso volta a divergir toda vez que um PWA é
# reinstalado — por isso o hash lá em cima é o das linhas Exec=, e não a versão
# do pacote: mexeu num lançador, o script roda de novo no próximo apply.
applications_dir=${XDG_DATA_HOME:-"$HOME/.local/share"}/applications
raw_binary=/opt/brave-bin/brave
wrapper=/usr/bin/brave

[[ -d "$applications_dir" ]] || exit 0
[[ -x "$wrapper" ]] || exit 0

shopt -s nullglob
launchers=("$applications_dir"/brave-*.desktop)
shopt -u nullglob
[[ ${#launchers[@]} -gt 0 ]] || exit 0

changed=0
for launcher in "${launchers[@]}"; do
    grep -q "^Exec=$raw_binary " "$launcher" || continue

    # Só a linha Exec=, e só o prefixo do executável: os argumentos (app-id,
    # user-data-dir, %U) têm que sobreviver intactos, inclusive nos grupos
    # [Desktop Action], que também carregam Exec= próprio.
    #
    # O sufixo .desktop no mktemp não é estética: desktop-file-validate recusa
    # qualquer arquivo com outra extensão antes mesmo de olhar o conteúdo.
    temporary_file=$(mktemp --suffix=.desktop "$applications_dir/.brave-norm.XXXXXX")
    sed "s|^Exec=$raw_binary |Exec=$wrapper |" "$launcher" > "$temporary_file"

    # Alguns lançadores que o Brave gera já nascem inválidos (Type=Application
    # junto de uma chave URL, por exemplo). Barrar por isso seria recusar
    # consertar justamente os arquivos problemáticos, então o que interessa é
    # se a troca do Exec introduziu erro novo — não o estado absoluto.
    if command -v desktop-file-validate >/dev/null; then
        before=$(desktop-file-validate "$launcher" 2>&1 | sed "s|^$launcher||" || true)
        after=$(desktop-file-validate "$temporary_file" 2>&1 | sed "s|^$temporary_file||" || true)
        if [[ "$before" != "$after" ]]; then
            rm -f "$temporary_file"
            echo "brave-launchers: ${launcher##*/} regrediu na validação, mantido" >&2
            continue
        fi
    fi

    # install em vez de mv: o mktemp nasce 0600 e o .desktop precisa ser legível.
    install -m 0644 "$temporary_file" "$launcher"
    rm -f "$temporary_file"
    changed=$((changed + 1))
    echo "brave-launchers: ${launcher##*/} apontado pro wrapper"
done

# Quando um PWA ganha um lançador curado aqui no repo, o que o Brave gerou
# sozinho vira entrada repetida no menu, com o mesmo ícone e mesmo destino.
# Detecta por app-id em vez de lista fixa: um PWA novo que receba lançador
# curado passa a ser tratado sem precisar mexer neste script.
#
# NoDisplay em vez de apagar: o arquivo continua existindo, então nada que
# esteja fixado na barra de tarefas quebra, e o Brave não fica recriando.
declare -A app_id_count=()
for launcher in "${launchers[@]}"; do
    app_id=$(sed -n 's/^Exec=.*--app-id=\([a-p]\{32\}\).*/\1/p' "$launcher" | head -1)
    [[ -n "$app_id" ]] && app_id_count[$app_id]=$(( ${app_id_count[$app_id]:-0} + 1 ))
done

for app_id in "${!app_id_count[@]}"; do
    (( app_id_count[$app_id] > 1 )) || continue
    # Só o de nomenclatura gerada pelo Brave é escondido; o curado é o que fica.
    generated=$applications_dir/brave-$app_id-Default.desktop
    [[ -f "$generated" ]] || continue
    grep -q "^NoDisplay=true" "$generated" && continue

    if grep -q "^NoDisplay=" "$generated"; then
        sed -i "s|^NoDisplay=.*|NoDisplay=true|" "$generated"
    else
        sed -i "/^\[Desktop Entry\]/a NoDisplay=true" "$generated"
    fi
    changed=$((changed + 1))
    echo "brave-launchers: ${generated##*/} ocultado (duplica um lançador curado)"
done

# O Brave também larga cópia dos lançadores na área de trabalho. Só remove a
# que tem par de mesmo nome em applications/ — atalho que exista apenas no
# desktop é intencional e não é problema deste script.
desktop_dir=$(xdg-user-dir DESKTOP 2>/dev/null || printf '%s/Desktop' "$HOME")
if [[ -d "$desktop_dir" && "$desktop_dir" != "$HOME" ]]; then
    shopt -s nullglob
    for stray in "$desktop_dir"/brave-*.desktop; do
        [[ -f "$applications_dir/${stray##*/}" ]] || continue
        rm -f "$stray"
        changed=$((changed + 1))
        echo "brave-launchers: ${stray##*/} removido da área de trabalho"
    done
    shopt -u nullglob
fi

if [[ $changed -gt 0 ]] && command -v update-desktop-database >/dev/null; then
    update-desktop-database "$applications_dir"
fi
{{ end }}
