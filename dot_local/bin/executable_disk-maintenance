#!/usr/bin/env bash
# Poda frequente de imagens e caches conhecidos, sem remover dados de containers.
set -euo pipefail

dry_run=false
case "${1:-}" in
    '') ;;
    --dry-run) dry_run=true ;;
    *) echo "uso: ${0##*/} [--dry-run]" >&2; exit 2 ;;
esac
[[ $# -le 1 ]] || exit 2
[[ $(uname -s) == Linux ]] || { echo 'pulo (somente Linux)'; exit 0; }
[[ $EUID -ne 0 ]] || { echo 'Execute como usuário, sem sudo.' >&2; exit 2; }
umask 077
cache_dir=${XDG_CACHE_HOME:-"$HOME/.cache"}
state_dir=${XDG_STATE_HOME:-"$HOME/.local/state"}/disk-maintenance
errors=0

# Serializa também chamadas manuais. Dry-run não cria estado nem marca sucesso.
if ! $dry_run; then
    mkdir -p "$state_dir"
    exec 9>"$state_dir/lock"
    flock -n 9 || { echo 'pulo (manutenção já em execução)'; exit 0; }
fi

run() {
    $dry_run && printf '[dry-run] '
    printf '%q ' "$@"
    printf '\n'
    if ! $dry_run; then
        if ! "$@"; then
            echo "falha: $1 (continuando os demais alvos)" >&2
            errors=$((errors + 1))
        fi
    fi
}

# Mede também stores em outra partição; a pior condição decide a retenção.
pressure=false
critical=false
measure() {
    local path=$1 used available
    [[ -d $path ]] || return 0
    read -r used available < <(df -Pk -- "$path" | awk 'END {gsub(/%/, "", $5); print $5, $4}')
    [[ $used =~ ^[0-9]+$ && $available =~ ^[0-9]+$ ]] || return 1
    printf 'espaço: %s: %s%% usados, %s GiB disponíveis\n' "$path" "$used" "$((available / 1048576))"
    if (( used >= 75 || available < 40 * 1048576 )); then pressure=true; fi
    if (( used >= 85 || available < 20 * 1048576 )); then critical=true; fi
}
measure "$HOME"
measure "$cache_dir"
if command -v podman >/dev/null 2>&1; then
    if graph_root=$(podman info --format '{{.Store.GraphRoot}}'); then
        measure "$graph_root"
    else
        errors=$((errors + 1))
    fi
fi
image_age=72h
cache_minutes=10080
if $pressure; then
    image_age=24h
    cache_minutes=1440
    echo 'pressão de espaço: retenção reduzida para 24h'
fi

# --all inclui tags, mas mantém imagens referenciadas por QUALQUER container.
# Não usar system/container/volume prune, --external nem --build-cache: esses
# modos alcançam estado persistente ou builds que podem estar em andamento.
if command -v podman >/dev/null 2>&1; then
    run podman image prune --all --force --filter "until=$image_age" --filter 'label!=disk-maintenance.keep=true'
else
    echo 'pulo (podman ausente; Docker nativo não é gerenciado por este script)'
fi

# A idade de escrita define a poda; atime é uma proteção adicional somente
# onde o filesystem registra acessos. Em noatime, leituras não renovam o cache.
# A lista é fechada: .cache também contém bancos de histórico dos agentes.
prune_files() {
    local target=$1
    [[ -d $target && ! -L $target ]] || return 0
    run find "$target" -xdev -type f -mmin "+$cache_minutes" -amin "+$cache_minutes" -delete
}

now=$(date +%s)
last_cache=0
# Um processo interrompido ou um marcador antigo inválido não pode bloquear GC.
if [[ -r $state_dir/last-cache ]]; then
    IFS= read -r last_cache < "$state_dir/last-cache" || last_cache=0
fi
if [[ $last_cache =~ ^[0-9]{1,10}$ ]]; then
    last_cache=$((10#$last_cache))
    (( last_cache <= now )) || last_cache=0
else
    last_cache=0
fi
if $pressure || (( now - last_cache >= 86400 )); then
    cache_errors=$errors
    prune_files "$cache_dir/go-build"
    prune_files "$cache_dir/pip"
    prune_files "$HOME/.npm/_cacache"
    # uv coordena o acesso com processos ativos; nunca passar --force.
    if command -v uv >/dev/null 2>&1; then run uv cache prune --ci; fi
    # Os builds AUR não têm uma API de GC. Só removemos diretórios inteiramente
    # frios, sem processos de instalação/compilação de pacotes em andamento.
    if pgrep -x 'paru|yay|makepkg|pacman' >/dev/null; then
        echo 'pulo paru (gerenciador de pacotes em execução)'
    elif [[ -d $cache_dir/paru/clone && ! -L $cache_dir/paru && ! -L $cache_dir/paru/clone ]]; then
        while IFS= read -r -d '' target; do
            # Saída vazia só autoriza a poda quando a inspeção teve sucesso.
            if recent=$(find "$target" -xdev -type f \( -mmin -10080 -o -amin -10080 \) -print -quit); then
                if [[ -z $recent ]]; then run rm -rf --one-file-system -- "$target"; fi
            else
                echo "falha ao inspecionar (preservado): $target" >&2
                errors=$((errors + 1))
            fi
        done < <(find "$cache_dir/paru/clone" -mindepth 1 -maxdepth 1 -type d -print0)
    fi
    if ! $dry_run && (( errors == cache_errors )); then
        # Rename no mesmo filesystem mantém o marcador anterior íntegro em falhas.
        marker_tmp=$(mktemp "$state_dir/last-cache.XXXXXX")
        trap 'rm -f -- "$marker_tmp"' EXIT
        if printf '%s\n' "$now" > "$marker_tmp" && mv -f -- "$marker_tmp" "$state_dir/last-cache"; then
            trap - EXIT
        else
            echo 'falha ao atualizar marcador de caches' >&2
            errors=$((errors + 1))
        fi
    fi
else
    echo 'pulo caches (última poda há menos de 24h)'
fi

# Reavalia após a poda: um store preso por containers precisa de ação humana,
# nunca de remoção automática de volumes para ganhar espaço.
pressure=false
critical=false
measure "$HOME"
measure "$cache_dir"
[[ -z ${graph_root:-} ]] || measure "$graph_root"
if $pressure || (( errors > 0 )); then
    message='Pouco espaço ou falha na limpeza. Consulte journalctl --user -u disk-maintenance.service.'
    echo "AVISO: $message" >&2
    if command -v notify-send >/dev/null 2>&1; then
        urgency=normal
        $critical && urgency=critical
        run notify-send --app-name=disk-maintenance --urgency="$urgency" 'Manutenção de disco' "$message"
    fi
fi
if (( errors > 0 )); then exit 1; fi
echo 'disk-maintenance: concluído'
