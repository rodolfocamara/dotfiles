#!/usr/bin/env bash
#
# Limpeza semanal de caches regeneráveis do usuário e órfãos de podman.
#
# Roda como usuário, sem sudo: tudo aqui é regenerável (re-download/rebuild)
# e usa ferramentas do usuário. O que exige root — cache do pacman e
# snapshots do snapper — já tem timer de sistema (paccache.timer,
# snapper-cleanup.timer); este script cobre só o que eles não alcançam.
#
#   disk-maintenance [--dry-run]

set -euo pipefail

dry_run=false
case "${1:-}" in
    '') ;;
    --dry-run) dry_run=true ;;
    *)
        echo "uso: ${0##*/} [--dry-run]" >&2
        exit 2
        ;;
esac

cache_dir=${XDG_CACHE_HOME:-"$HOME/.cache"}

# Conta só o que está por baixo do alvo — para relatar o tamanho antes de
# apagar. Caches grandes podem demorar um pouco; é semanal, o custo cabe.
wipe() {
    local target=$1
    if [[ ! -d $target ]]; then
        echo "skip (não existe): $target"
        return 0
    fi
    if $dry_run; then
        echo "[dry-run] apagaria: $target ($(du -sh "$target" | cut -f1))"
        return 0
    fi
    echo "limpando: $target ($(du -sh "$target" | cut -f1))"
    find "$target" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +
}

# Caches de toolchain se regeneram na próxima compilação/download; o go-build
# costuma crescer sem teto em worktrees com builds paralelas.
wipe "$cache_dir/go-build"
wipe "$cache_dir/codex-update-manager"
wipe "$cache_dir/codex-runtimes"

# O paru -Sc só limpa o cache de pacotes, não os clones e builds em
# ~/.cache/paru — que sem poda acumulam indefinidamente (14G em um mês).
wipe "$cache_dir/paru"

if command -v uv >/dev/null 2>&1; then
    if $dry_run; then
        echo "[dry-run] uv cache clean"
    else
        uv cache clean
    fi
fi

# Caminhos extras por máquina (caches de projetos, por exemplo), um por
# linha. Fica fora do repo de propósito: os caminhos variam por máquina e um
# deles pode ser de projeto de trabalho — nada disso no source público.
# Apaga só se nada foi modificado há mais de 14 dias, para não queimar o
# cache quente de um projeto ativo.
extra_list=${XDG_CONFIG_HOME:-"$HOME/.config"}/disk-maintenance/extra-caches.list
if [[ -r $extra_list ]]; then
    while IFS= read -r line; do
        line=${line%%#*}
        [[ -n ${line//[[:space:]]/} ]] || continue
        target=$line
        [[ $target == \~/* ]] && target=$HOME/${target#\~/}
        if [[ ! -d $target ]]; then
            echo "pulo (não existe): $target"
        elif [[ -n $(find "$target" -maxdepth 2 -type f -mtime -14 -print -quit) ]]; then
            echo "pulo (tocado nos últimos 14 dias): $target"
        else
            wipe "$target"
        fi
    done < "$extra_list"
fi

# Órfãos de compose stacks mortas: containers exited (os rodando ficam),
# imagens sem container e volumes anônimos. O volume prune sem --all só
# toca anônimos — os nomeados, com dados de banco, permanecem.
if command -v podman >/dev/null 2>&1; then
    if $dry_run; then
        echo "[dry-run] podman container prune / image prune -a / volume prune"
    else
        podman container prune -f
        podman image prune -af
        podman volume prune -f
    fi
else
    echo "pulo (podman ausente)"
fi

echo "disk-maintenance: concluído"