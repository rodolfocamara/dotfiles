#!/usr/bin/env bash

set -uo pipefail

readonly -a levels=(5 30 60)
readonly -a ddc_buses=(16 17) # LG 3440x1440 and LG 34GL750
declare -Ar ddc_weight_numerator=([16]=1 [17]=7)
declare -Ar ddc_weight_denominator=([16]=1 [17]=6)
readonly internal_weight_numerator=2
readonly internal_weight_denominator=3
readonly state_dir="${XDG_STATE_HOME:-"$HOME/.local/state"}/display-brightness"
readonly state_file="$state_dir/level"
readonly power_service=org.kde.ScreenBrightness
readonly power_object=/org/kde/Solid/PowerManagement/Actions/BrightnessControl
readonly power_interface=org.kde.Solid.PowerManagement.Actions.BrightnessControl

brightness_dbus() {
  local method=$1
  shift
  qdbus6 "$power_service" "$power_object" "$power_interface.$method" "$@" 2>/dev/null
}

internal_percentage() {
  local current maximum
  current=$(brightness_dbus brightness) || return 1
  maximum=$(brightness_dbus brightnessMax) || return 1
  [[ "$current" =~ ^[0-9]+$ && "$maximum" =~ ^[1-9][0-9]*$ ]] || return 1
  printf '%d\n' "$(((current * 100 + maximum / 2) / maximum))"
}

scale_percentage() {
  local percentage=$1 numerator=$2 denominator=$3 scaled
  scaled=$(((percentage * numerator + denominator / 2) / denominator))
  ((scaled > 100)) && scaled=100
  printf '%d\n' "$scaled"
}

logical_percentage_from_internal() {
  local internal
  internal=$(internal_percentage) || return 1
  scale_percentage \
    "$internal" "$internal_weight_denominator" "$internal_weight_numerator"
}

saved_percentage() {
  local saved
  [[ -r "$state_file" ]] || return 1
  read -r saved < "$state_file" || return 1
  [[ "$saved" =~ ^[0-9]+$ ]] || return 1
  saved=$((10#$saved))
  ((saved <= 100)) || return 1
  printf '%d\n' "$saved"
}

persist_percentage() {
  local logical_percentage=$1 internal_percentage=$2 profile temporary_file

  install -d -m0700 "$state_dir"
  temporary_file=$(mktemp "$state_dir/.level.XXXXXX") || return 1
  printf '%s\n' "$logical_percentage" > "$temporary_file"
  chmod 0600 "$temporary_file"
  mv -f "$temporary_file" "$state_file"

  for profile in AC Battery LowBattery; do
    kwriteconfig6 --file powerdevilrc \
      --group "$profile" --group Display \
      --key DisplayBrightness "$internal_percentage"
  done
}

notify_percentage() {
  local percentage=$1 message=$2
  [[ "${DISPLAY_BRIGHTNESS_QUIET:-0}" != 1 ]] || return 0
  command -v notify-send >/dev/null || return 0
  notify-send --app-name='Brilho dos monitores' --expire-time=1800 \
    --hint=string:x-canonical-private-synchronous:display-brightness-sync \
    --hint="int:value:${percentage}" \
    'Brilho sincronizado' "$message"
}

set_ddc_percentage() {
  local bus=$1 target=$2 attempt

  for attempt in 1 2; do
    timeout 8s ddcutil --bus "$bus" setvcp 10 "$target" \
      >/dev/null 2>&1 && return 0
    ((attempt == 1)) && sleep 0.25
  done
  return 1
}

set_all() {
  local logical_percentage=$1 bus pid maximum target internal_ok=true
  local internal_target bottom_target top_target
  local -a failures=()
  declare -A jobs=()

  bottom_target=$(scale_percentage \
    "$logical_percentage" "${ddc_weight_numerator[16]}" "${ddc_weight_denominator[16]}")
  top_target=$(scale_percentage \
    "$logical_percentage" "${ddc_weight_numerator[17]}" "${ddc_weight_denominator[17]}")
  internal_target=$(scale_percentage \
    "$logical_percentage" "$internal_weight_numerator" "$internal_weight_denominator")

  for bus in "${ddc_buses[@]}"; do
    if [[ ! -e "/dev/i2c-$bus" ]]; then
      failures+=("DDC bus $bus")
      continue
    fi
    target=$(scale_percentage \
      "$logical_percentage" "${ddc_weight_numerator[$bus]}" "${ddc_weight_denominator[$bus]}")
    set_ddc_percentage "$bus" "$target" &
    jobs[$!]=$bus
  done

  maximum=$(brightness_dbus brightnessMax) || internal_ok=false
  if [[ "$internal_ok" == true && "$maximum" =~ ^[1-9][0-9]*$ ]]; then
    target=$(((maximum * internal_target + 50) / 100))
    brightness_dbus setBrightnessSilent "$target" >/dev/null || internal_ok=false
  else
    internal_ok=false
  fi

  for pid in "${!jobs[@]}"; do
    wait "$pid" || failures+=("monitor DDC bus ${jobs[$pid]}")
  done
  [[ "$internal_ok" == true ]] || failures+=("tela do notebook")
  persist_percentage "$logical_percentage" "$internal_target" || failures+=("persistência")

  if ((${#failures[@]} == 0)); then
    notify_percentage "$logical_percentage" \
      "Perfil ${logical_percentage}% — inferior ${bottom_target}%, superior ${top_target}%, notebook ${internal_target}%"
    return 0
  fi
  notify_percentage "$logical_percentage" \
    "Perfil ${logical_percentage}% aplicado; falhou: ${failures[*]}"
  return 1
}

next_percentage() {
  local current level
  current=$(saved_percentage) || current=$(logical_percentage_from_internal) || current=30
  for level in "${levels[@]}"; do
    if ((current < level - 2)); then
      printf '%d\n' "$level"
      return
    fi
  done
  printf '%d\n' "${levels[0]}"
}

usage() {
  printf 'Usage: %s [cycle | set PERCENT | restore | current]\n' "${0##*/}" >&2
}

case "${1:-cycle}" in
  cycle)
    set_all "$(next_percentage)"
    ;;
  set)
    if [[ ! "${2:-}" =~ ^[0-9]+$ ]] || ((10#${2:-0} > 100)); then
      usage
      exit 2
    fi
    set_all "$((10#$2))"
    ;;
  restore)
    set_all "$(saved_percentage || printf '30\n')"
    ;;
  current)
    saved_percentage || logical_percentage_from_internal
    ;;
  *)
    usage
    exit 2
    ;;
esac
