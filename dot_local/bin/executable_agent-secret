#!/usr/bin/env bash
# agent-secret: injeta segredos do Bitwarden no ambiente de um comando, sem exibi-los.
#
#   agent-secret exec VAR=item[:campo] [VAR=item[:campo] ...] -- comando args...
#   VAR=$(agent-secret get item[:campo])   só capturado em variável, nunca solto no terminal
#   agent-secret check item[:campo] ...
#
# "campo" é "password" (padrão), "username", "notes" ou o nome de um campo customizado.
# Busca o item pelo nome em qualquer pasta; AGENT_SECRET_FOLDER restringe a uma pasta.
# Campos que o rbw não grava podem ir nas notas como "chave=valor" (ex.: server=...).
# Backend: rbw (padrão) ou bw (AGENT_SECRET_BACKEND=bw, exige BW_SESSION).
set -euo pipefail
umask 077

folder="${AGENT_SECRET_FOLDER:-}"
backend="${AGENT_SECRET_BACKEND:-rbw}"

fail() { printf 'agent-secret: %s\n' "$*" >&2; exit 1; }

fetch() {
  local item="${1%%:*}" field="password"
  [[ "$1" == *:* ]] && field="${1#*:}"
  case "$backend" in
    rbw)
      rbw unlocked >/dev/null 2>&1 || rbw unlock || fail "não foi possível desbloquear o rbw"
      local json
      json="$(rbw get ${folder:+--folder "$folder"} --raw "$item")"
      case "$field" in
        password) jq -r '.data.password' <<<"$json" ;;
        username) jq -r '.data.username' <<<"$json" ;;
        notes)    jq -r '.notes' <<<"$json" ;;
        *)        jq -r --arg f "$field" '((.fields // [])[] | select(.name==$f) | .value),
                      ((.notes // "") | split("\n")[] | select(startswith($f + "=")) | sub("^[^=]*="; ""))' <<<"$json" | head -n1 ;;
      esac
      ;;
    bw)
      [[ -n "${BW_SESSION:-}" ]] || fail "BW_SESSION vazio: rode 'export BW_SESSION=\$(bw unlock --raw)'"
      local json
      json="$(bw get item "$item")"
      case "$field" in
        password) jq -r '.login.password' <<<"$json" ;;
        username) jq -r '.login.username' <<<"$json" ;;
        notes)    jq -r '.notes' <<<"$json" ;;
        *)        jq -r --arg f "$field" '.fields[] | select(.name==$f) | .value' <<<"$json" ;;
      esac
      ;;
    *) fail "backend desconhecido: $backend" ;;
  esac
}

cmd="${1:-}"; shift || true
case "$cmd" in
  exec)
    declare -a assigns=()
    while (($#)) && [[ "$1" != "--" ]]; do assigns+=("$1"); shift; done
    [[ "${1:-}" == "--" ]] || fail "falta '--' antes do comando"
    shift
    (($#)) || fail "nenhum comando informado"
    for a in "${assigns[@]}"; do
      var="${a%%=*}"; ref="${a#*=}"
      [[ "$var" =~ ^[A-Z_][A-Z0-9_]*$ ]] || fail "nome de variável inválido: $var"
      value="$(fetch "$ref")" || fail "item não encontrado: $ref"
      [[ -n "$value" && "$value" != "null" ]] || fail "valor vazio: $ref"
      export "$var=$value"
    done
    exec "$@"
    ;;
  get)
    (($# == 1)) || fail "uso: VAR=\$(agent-secret get item[:campo])"
    [[ -t 1 ]] && fail "get imprimiria o segredo no terminal; capture em variável"
    value="$(fetch "$1")" || fail "item não encontrado: $1"
    [[ -n "$value" && "$value" != "null" ]] || fail "valor vazio: $1"
    printf '%s' "$value"
    ;;
  check)
    for ref in "$@"; do
      if value="$(fetch "$ref" 2>/dev/null)" && [[ -n "$value" && "$value" != "null" ]]; then
        printf 'ok       %s\n' "$ref"
      else
        printf 'faltando %s\n' "$ref"
      fi
    done
    ;;
  *)
    sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'
    exit 2
    ;;
esac
