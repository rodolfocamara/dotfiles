#!/usr/bin/env bash
set -euo pipefail
umask 077

readonly context_dir="${XDG_DATA_HOME:-$HOME/.local/share}/agent-context"
readonly canonical_file="$context_dir/AGENTS.md"
readonly skills_dir="$context_dir/skills"
readonly default_source="$HOME/.claude-personal/CLAUDE.md"

usage() {
  cat <<'USAGE'
Uso:
  agent-context-sync [--source FILE] [--dry-run]

Compartilha uma fonte local e privada de instruções e skills entre as
ferramentas de agente da máquina. O conteúdo não entra no repositório dotfiles.

Instruções: ~/.local/share/agent-context/AGENTS.md vira o CLAUDE.md de cada
perfil do Claude Code, o AGENTS.md do Codex e do OpenCode e o GEMINI.md do
Gemini/Antigravity, por symlink.

Skills: cada subpasta de ~/.local/share/agent-context/skills/<grupo>/ que tenha
SKILL.md ganha um symlink próprio nos destinos do grupo:

  comum     ~/.agents/skills e os perfis personal, work e glm do Claude Code
  trabalho  ~/.agents/skills e os perfis personal e work do Claude Code

~/.agents/skills é lido por Codex, Cursor, Gemini e OpenCode. O Claude Code
não lê esse caminho, por isso recebe os links no próprio perfil.

Links que apontam para a fonte mas cuja skill não existe mais são removidos.
Arquivos divergentes nunca são sobrescritos: a sincronização para e pede
resolução manual.
USAGE
}

fail() {
  printf 'erro: %s\n' "$*" >&2
  exit 1
}

source_file="$default_source"
dry_run=0

while (($#)); do
  case "$1" in
    --source)
      [[ $# -ge 2 ]] || fail '--source exige um caminho'
      source_file="$2"
      shift 2
      ;;
    --dry-run)
      dry_run=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      fail "argumento desconhecido: $1"
      ;;
  esac
done

run() {
  if [[ "$dry_run" == '1' ]]; then
    printf 'DRY-RUN: %s\n' "$*"
  else
    "$@"
  fi
}

comparison_file="$canonical_file"
if [[ ! -f "$canonical_file" ]]; then
  [[ -f "$source_file" ]] || fail "fonte de contexto não encontrada: $source_file"
  comparison_file="$source_file"
  printf 'Inicializando contexto compartilhado a partir de %s\n' "$source_file"

  if [[ "$dry_run" == '0' ]]; then
    install -d -m 700 "$context_dir"
    temporary="$(mktemp "$context_dir/.AGENTS.md.XXXXXX")"
    trap 'rm -f "$temporary"' EXIT
    cp "$source_file" "$temporary"
    chmod 600 "$temporary"
    mv "$temporary" "$canonical_file"
    trap - EXIT
    comparison_file="$canonical_file"
  fi
fi

instruction_targets=(
  "$HOME/.claude/CLAUDE.md"
  "$HOME/.claude-personal/CLAUDE.md"
  "$HOME/.claude-work/CLAUDE.md"
  "$HOME/.claude-glm/CLAUDE.md"
  "$HOME/.codex/AGENTS.md"
  "$HOME/.config/opencode/AGENTS.md"
  "$HOME/.gemini/GEMINI.md"
)

timestamp="$(date +%Y%m%d%H%M%S)"
for target in "${instruction_targets[@]}"; do
  if [[ -L "$target" && "$(readlink -f "$target" 2>/dev/null || true)" == "$canonical_file" ]]; then
    printf 'Já compartilhado: %s\n' "$target"
    continue
  fi

  # Um destino cuja ferramenta não está instalada fica de fora, em vez de
  # criar diretórios de ferramentas que a máquina não usa.
  [[ -d "$(dirname "$target")" ]] || { printf 'Ignorado (ferramenta ausente): %s\n' "$target"; continue; }

  if [[ -e "$target" || -L "$target" ]]; then
    if [[ ! -f "$target" ]] || ! cmp -s "$comparison_file" "$target"; then
      fail "arquivo divergente em $target; faça o merge antes de sincronizar"
    fi
    run mv "$target" "$target.pre-agent-context.$timestamp"
  fi

  printf 'Compartilhando: %s -> %s\n' "$target" "$canonical_file"
  run ln -s "$canonical_file" "$target"
done

declare -A group_targets=(
  [comum]="$HOME/.agents/skills $HOME/.claude-personal/skills $HOME/.claude-work/skills $HOME/.claude-glm/skills"
  [trabalho]="$HOME/.agents/skills $HOME/.claude-personal/skills $HOME/.claude-work/skills"
)

all_roots=()
for group in "${!group_targets[@]}"; do
  read -r -a roots <<<"${group_targets[$group]}"
  all_roots+=("${roots[@]}")
done
mapfile -t all_roots < <(printf '%s\n' "${all_roots[@]}" | sort -u)

for root in "${all_roots[@]}"; do
  # Um diretório de skills inteiro como symlink faz um perfil herdar todas as
  # skills de outro, inclusive as que não são do grupo dele.
  if [[ -L "$root" ]]; then
    printf 'Convertendo symlink de diretório em diretório real: %s\n' "$root"
    run rm "$root"
  fi
  [[ "$dry_run" == '1' ]] || mkdir -p "$root"
done

for group in "${!group_targets[@]}"; do
  [[ -d "$skills_dir/$group" ]] || continue
  read -r -a roots <<<"${group_targets[$group]}"

  for source_skill in "$skills_dir/$group"/*; do
    [[ -d "$source_skill" && -f "$source_skill/SKILL.md" ]] || continue
    skill_name="$(basename "$source_skill")"
    [[ "$skill_name" =~ ^[a-z0-9][a-z0-9-]{0,63}$ ]] \
      || fail "nome de skill inválido: $skill_name"

    for root in "${roots[@]}"; do
      target_skill="$root/$skill_name"
      current="$(readlink -f "$target_skill" 2>/dev/null || true)"

      if [[ -L "$target_skill" && "$current" == "$source_skill" ]]; then
        continue
      fi

      if [[ -L "$target_skill" ]]; then
        # Link antigo para outro lugar: troca, porque o link não guarda conteúdo.
        run rm "$target_skill"
      elif [[ -e "$target_skill" ]]; then
        fail "skill divergente em $target_skill; mova ou apague antes de sincronizar"
      fi

      printf 'Compartilhando skill (%s): %s\n' "$group" "$target_skill"
      run ln -s "$source_skill" "$target_skill"
    done
  done
done

for root in "${all_roots[@]}"; do
  [[ -d "$root" ]] || continue
  for link in "$root"/*; do
    [[ -L "$link" ]] || continue
    destination="$(readlink "$link")"
    [[ "$destination" == "$context_dir"/* ]] || continue
    if [[ ! -f "$destination/SKILL.md" ]]; then
      printf 'Removendo link órfão: %s\n' "$link"
      run rm "$link"
    else
      # A skill existe, mas saiu do grupo deste destino.
      group_of_link="$(basename "$(dirname "$destination")")"
      case " ${group_targets[$group_of_link]:-} " in
        *" $root "*) ;;
        *)
          printf 'Removendo link fora do grupo (%s): %s\n' "$group_of_link" "$link"
          run rm "$link"
          ;;
      esac
    fi
  done
done

if command -v codex >/dev/null 2>&1; then
  if codex features list 2>/dev/null | awk '$1 == "memories" && $NF == "true" { found=1 } END { exit !found }'; then
    printf 'Memórias locais do Codex já estão habilitadas\n'
  elif [[ "$dry_run" == '1' ]]; then
    printf 'DRY-RUN: codex features enable memories\n'
  else
    codex features enable memories
  fi
else
  printf 'Codex não encontrado; habilitação de memórias ignorada\n'
fi
