#!/usr/bin/env bash

set -euo pipefail

pictures_dir=$(xdg-user-dir PICTURES 2>/dev/null || true)
[[ -n "$pictures_dir" ]] || pictures_dir="$HOME/Pictures"
screenshot_dir="$pictures_dir/Screenshots"
output_file="$screenshot_dir/Screenshot_$(date +%Y%m%d_%H%M%S_%3N).png"

mkdir -p "$screenshot_dir"

# Let Spectacle publish the image itself. This happens as part of the capture,
# so graphical apps can paste immediately and no polling is needed.
spectacle --background --region --copy-image

# Persist the same clipboard PNG and expose only its path through the primary
# selection for terminals.
if ! wl-paste --type image/png > "$output_file"; then
    rm -f -- "$output_file"
    exit 0
fi
[[ -s "$output_file" ]] || { rm -f -- "$output_file"; exit 0; }

wl-copy --primary --type text/plain "$output_file"
