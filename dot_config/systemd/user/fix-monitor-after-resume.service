[Unit]
Description=Repair the display and Bluetooth mouse after screen wake or resume
Documentation=file://%h/Repos/dotfiles/docs/nvidia-displays.md file://%h/Repos/dotfiles/docs/bluetooth-mouse.md
PartOf=graphical-session.target
After=graphical-session.target
ConditionEnvironment=XDG_CURRENT_DESKTOP=KDE

[Service]
Type=simple
Environment=FIX_MONITOR_TARGET=HDMI-A-1
Environment=FIX_MONITOR_DELAY_SECONDS=5
Environment=FIX_BLUETOOTH_MOUSE=DC:8E:F7:60:E6:59
ExecStart=%h/.local/bin/fix-monitor-after-resume
Restart=always
RestartSec=3

[Install]
WantedBy=graphical-session.target
