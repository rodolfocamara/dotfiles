{{/* ---------------------------------------------------------------------
     Perfil de máquina.

     O SO sozinho não separa este repo: as duas máquinas Linux rodam
     desktops diferentes (uma Hyprland, outra KDE), e o config de desktop
     de uma é lixo pendurado na outra — aparece como alvo pendente em todo
     `chezmoi status` e some no meio do ruído.

     Defina o perfil em .chezmoidata.toml na raiz do source. Esse arquivo é
     por máquina e não vai pro git (está no .gitignore):

         profile = "hyprland"    # ou "kde", ou "generic"

     Sem esse arquivo, detecta pelo binário do compositor — máquina com
     Hyprland instalado recebe o stack, o resto não.

     Ver docs/machine-profiles.md.
     --------------------------------------------------------------------- */}}
{{- $profile := (index . "profile") | default (ternary "hyprland" "generic" (ne (lookPath "Hyprland") "")) }}

# Standard ignored files/folders
README.md

# Never create these in ~ (repo structure only)
docs/
packages/
scripts/
home/
# etc/ NÃO é alvo do chezmoi. O destDir dele é sempre o home, então esta
# árvore mapearia para ~/etc/openvpn/... — lixo no home, e os arquivos nunca
# chegariam em /etc. Quem instala é scripts/install-etc.sh. Ver docs/openvpn.md.
etc/

# Stack de desktop do Hyprland. Fora do perfil hyprland não tem alvo com
# sentido — inclusive no Windows, onde $profile cai em "generic".
{{ if ne $profile "hyprland" }}
.config/hypr/
.config/waybar/
.config/wofi/
.config/kitty/
{{ end }}

# Workaround de wake/modeset específico do KScreen + KWin. O serviço chama
# kscreen-doctor e observa o D-Bus do screen locker do Plasma.
{{ if ne $profile "kde" }}
.config/kdeconnect/config
.config/systemd/user/fix-monitor-after-resume.service
.config/systemd/user/graphical-session.target.wants/fix-monitor-after-resume.service
.local/bin/battery-conservation
.local/bin/display-brightness-cycle
.local/bin/fix-monitor-after-resume
.local/bin/fix-bluetooth-mouse
.local/bin/screenshot-region-multiformat
.local/share/screenshot-clipboard/
.local/share/applications/brave-cadlkienfkclaiaibeoongdcgmdikeeg-Default.desktop
.local/share/applications/brave-azure-devops-work.desktop
.local/share/applications/brave-fmpnliohjhemenmnlpbfagaolkdacoja-Default.desktop
.local/share/applications/brave-outlook-work.desktop
.local/share/applications/brave-teams-work.desktop
.local/share/applications/display-brightness-cycle.desktop
.local/share/applications/screenshot-region-multiformat.desktop
{{ end }}

# Ignore Windows-only directories on Linux/macOS.
{{ if ne .chezmoi.os "windows" }}
apps/
Documents/
# %APPDATA% só existe no Windows (Zed lê settings.json de lá; no Linux/macOS
# o mesmo conteúdo sai em .config/zed/ via .chezmoitemplates/zed/).
AppData/
# .wslconfig é lido pelo Windows em %USERPROFILE%\.wslconfig. No Linux nativo
# não faz nada, e dentro do WSL também não (quem lê é o host).
.wslconfig
{{ end }}

# /etc/wsl.conf só existe dentro do WSL.
{{ if not (contains "microsoft" (lower (or .chezmoi.kernel.osrelease ""))) }}
etc/wsl.conf
{{ end }}

# Ignore Linux-specific scripts on Windows
{{ if eq .chezmoi.os "windows" }}
.chezmoiscripts/**/*.sh.tmpl
{{ end }}

# Ignore Windows-specific scripts on Linux/macOS
# Ignore Windows-only content on Linux/macOS
{{ if ne .chezmoi.os "windows" }}
.chezmoiscripts/**/*.ps1.tmpl
scripts/install-packages.windows.ps1
# Windows-only codex shim (.cmd); the bash wrapper handles WSL/Linux.
.local/bin/codex.cmd
{{ end }}

# Ignore Linux-only targets on Windows. No age key, and os configs de shell
# (direnv, zsh) não têm alvo com sentido. zsh roda dentro do WSL, que o chezmoi
# enxerga como Linux.
# Não estão listados aqui, de propósito: o stack de desktop (hypr, waybar,
# wofi, kitty), cortado pelo gate de $profile lá em cima, que já pega o
# Windows junto; e etc/, ignorado em todo OS, também lá em cima.
{{ if eq .chezmoi.os "windows" }}
.config/direnv/
.envrc
.zshenv
.zshrc
# fish é o shell de login no Arch/CachyOS. Não existe no Windows nativo; dentro
# do WSL funciona, e lá o chezmoi enxerga Linux.
.config/fish/
# SearxNG roda como quadlet rootless em systemd --user; nada disso existe no
# Windows nativo. No WSL funciona (exige podman instalado).
.config/containers/
.config/searxng/
# O Zed no Windows lê %APPDATA%\Zed\, não ~/.config/zed/. Mesmo conteúdo,
# alvo diferente: ver AppData/Roaming/Zed/ no source.
.config/zed/
# apps/windows_terminal/ has no active chezmoi mapping (Windows Terminal
# settings are managed by run_once scripts, not chezmoi targets).
apps/windows_terminal/
# apps/windhawk/ is source-only staging compiled/installed via
# sync-headset-widget.ps1, not a chezmoi target.
apps/windhawk/
# The codex bash wrapper is WSL/Linux-only; Windows uses codex.cmd instead.
.local/bin/codex
{{ end }}

# fish runtime state, not config: fish_variables is the universal-variable store
# fish rewrites on every `set -U` (and is mode 0600), and completions/ is
# regenerated from man pages. Listed here so a stray `chezmoi add` skips them.
.config/fish/fish_variables
.config/fish/completions/
